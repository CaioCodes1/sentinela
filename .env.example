# ---------------------------------------------------------------------------
# Sentinela — modelo de configuração.
#
# Copie para `.env` e preencha. O `.env` está no `.gitignore` e **nunca** deve
# ser versionado.
#
# Com `APP_ENV=production`, a aplicação **recusa subir** se qualquer segredo
# ainda estiver com o valor de exemplo abaixo, se o JWT_SECRET tiver menos de
# 32 caracteres, se DEBUG estiver ligado ou se CORS_ORIGINS for `*`.
# Falhar no boot é melhor que assinar token de produção com a chave que está
# publicada neste arquivo.
#
# Para gerar um segredo forte:
#   python -m app.cli gerar-segredo
# ---------------------------------------------------------------------------

# -- Aplicação --------------------------------------------------------------
APP_NAME=Sentinela
APP_ENV=development            # development | test | production
APP_VERSION=1.0.0
DEBUG=false
DOCS_ENABLED=true              # feche em produção: o /docs enumera toda a API
LOG_LEVEL=INFO
LOG_JSON=true

# `true` só quando existir um proxy reverso confiável na frente. Ligado sem
# proxy, qualquer cliente forja o próprio IP via X-Forwarded-For e escapa do
# rate limit — além de envenenar o campo de IP da auditoria.
TRUST_PROXY_HEADERS=false

# Lista separada por vírgula. Vazio = nenhuma origem cruzada permitida.
CORS_ORIGINS=

# -- Banco de dados ---------------------------------------------------------
DATABASE_URL=postgresql+psycopg://sentinela:troque-este-valor@localhost:5432/sentinela
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false                  # nunca `true` em produção: imprime os valores das queries

# -- Autenticação -----------------------------------------------------------
JWT_SECRET=troque-este-valor
JWT_ALGORITHM=HS256
JWT_ISSUER=sentinela
JWT_AUDIENCE=sentinela-api
ACCESS_TOKEN_TTL_MINUTES=15    # curto de propósito: token sem estado não é revogável
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12               # piso recomendado hoje
PASSWORD_MIN_LENGTH=12

# -- Bloqueio de conta ------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# -- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10

# -- Serviço externo de notificação -----------------------------------------
NOTIFIER_BASE_URL=http://localhost:9090
NOTIFIER_API_KEY=troque-este-valor
NOTIFIER_TIMEOUT_SECONDS=5
NOTIFIER_MAX_ATTEMPTS=3
NOTIFIER_BACKOFF_BASE_SECONDS=0.5
NOTIFIER_CIRCUIT_FAILURE_THRESHOLD=5
NOTIFIER_CIRCUIT_RESET_SECONDS=30

# -- Automação --------------------------------------------------------------
SCHEDULER_ENABLED=true
DAILY_JOB_HOUR=3               # hora UTC
DAILY_JOB_MINUTE=0
EXPIRATION_ALERT_DAYS=30,15,7,1

# -- Provisionamento inicial ------------------------------------------------
# Sem ADMIN_INITIAL_PASSWORD, `python -m app.cli criar-admin` falha com erro
# explícito — e sem usuário criado não há como fazer login.
ADMIN_INITIAL_EMAIL=admin@sentinela.local
ADMIN_INITIAL_PASSWORD=

# -- Testes de integração ---------------------------------------------------
# Usado só por `tests/integration`. Sem esta variável, esses testes são
# ignorados com uma mensagem explicando o que falta.
TEST_DATABASE_URL=postgresql+psycopg://sentinela:troque-este-valor@localhost:5432/sentinela_test

# -- Somente para o docker compose ------------------------------------------
# Estas variáveis são lidas pelo `docker-compose.yml`, não pela aplicação.
# A sintaxe `${VAR:?...}` no compose faz a pilha **recusar subir** se alguma
# faltar — melhor que subir com valor vazio.
POSTGRES_USER=sentinela
POSTGRES_PASSWORD=troque-este-valor
POSTGRES_DB=sentinela
POSTGRES_PORT=5432
API_PORT=8000
# Taxas de falha do provedor simulado. Zere para uma demonstração previsível.
STUB_FAILURE_RATE=0.25
STUB_TIMEOUT_RATE=0.10
